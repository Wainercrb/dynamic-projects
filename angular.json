{
  "version": 1,
  "projects": {
    "ejemplos": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "index": "index.html",
            "styles": [
              "node_modules/@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "outputPath": "dist/ejemplos",
            "server": "src/main.server.ts",
            "ssr": {
              "entry": "server.ts"
            },
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost", "127.0.0.1"]
            }
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "optimization": true,
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "450kB",
                  "maximumError": "600kB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ejemplos:build:development",
            "proxyConfig": "proxy.conf.json",
            "allowedHosts": ["localhost", "127.0.0.1"]
          }
        }
      }
    }
  }
}
