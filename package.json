    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "angular": "^1.8.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "jasmine": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "playwright-core": "^1.64.1",
