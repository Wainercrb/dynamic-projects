{
  "name": "angular-preguntas-practicas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently --kill-others \"npm:start:api\" \"npm:start:web\"",
    "build": "ng build",
    "test:smoke": "node tests/smoke.mjs",
    "prepare:angularjs": "node scripts/prepare-angularjs.mjs",
    "prestart": "npm run prepare:angularjs",
    "prebuild": "npm run prepare:angularjs",
    "test:angularjs": "CHROME_BIN=${CHROMIUM_PATH:-/usr/bin/chromium} karma start karma.conf.cjs",
    "test:protractor": "protractor examples/protractor/conf.cjs",
    "start:api": "tsx server/dev.ts",
    "start:web": "ng serve --host 0.0.0.0",
    "start:ssr": "node dist/ejemplos/server/server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:api": "tsx --test tests/api.spec.ts",
    "test:unit": "tsx --test tests/unit.spec.ts",
    "test:performance": "node tests/performance.mjs",
    "test:ssr": "node tests/ssr.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "^22.2.5",
    "angular": "^1.8.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "jasmine": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "protractor": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0"
  }
}
